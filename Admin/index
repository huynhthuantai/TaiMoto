];

function ensureDemoNews(){const existing=read(K.news);if(!existing.length)write(K.news,DEMO_NEWS);}
const $=id=>document.getElementById(id), read=(k,f=[])=>{try{let x=JSON.parse(localStorage.getItem(k));return Array.isArray(x)?x:f}catch{return f}},write=(k,v)=>localStorage.setItem(k,JSON.stringify(v));
const money=v=>Number(v||0).toLocaleString('vi-VN')+' đ';
const slug=s=>String(s||'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().replace(/đ/g,'d').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const ADMIN='TaiMoto@123';
function seoScore(n){let score=0,t=String(n.title||''),k=String(n.keyword||'').toLowerCase(),m=String(n.metaDescription||''),c=String(n.content||'').toLowerCase();if(t.length>=35&&t.length<=65)score+=20;if(t.toLowerCase().includes(k))score+=15;if(m.length>=120&&m.length<=165)score+=15;if(m.toLowerCase().includes(k))score+=10;if(c.includes(k))score+=15;if((c.match(/<h2/gi)||[]).length>=2)score+=10;if((c.match(/<img/gi)||[]).length>=1)score+=5;if((c.match(/faq|câu hỏi thường gặp/gi)||[]).length>=1)score+=5;if(n.slug)score+=5;return Math.min(score,100)}
function updateSEO(){const n={title:$('nTitle').value,keyword:$('nKeyword').value,metaDescription:$('nMeta').value,content:$('nContent').value,slug:$('nSlug').value};$('seoScore').textContent=seoScore(n);$('seoKeyword').textContent=(n.content.toLowerCase().match(new RegExp(n.keyword.replace(/[.*+?^${}()|[\\]\\\\]/g,'\\\\$&').toLowerCase(),'g'))||[]).length;$('seoTitleLen').textContent=n.title.length;$('seoMetaLen').textContent=n.metaDescription.length;$('previewTitle').textContent=n.title||'Tiêu đề bài viết';$('previewSlug').textContent=n.slug||'slug';$('previewMeta').textContent=n.metaDescription||'Mô tả SEO...'}
function renderNews(){const arr=read(K.news);$('sNews').textContent=arr.length;const tb=$('newsRows');tb.innerHTML='';arr.forEach(n=>{const tr=document.createElement('tr');tr.innerHTML='<td>'+esc(n.title)+'</td><td><span class="tag">'+esc(n.status)+'</span></td><td>'+seoScore(n)+'</td><td class="actions"><button class="btn btn-blue edit">Sửa</button><button class="btn btn-danger del">Xóa</button></td>';tr.querySelector('.edit').onclick=()=>editNews(n);tr.querySelector('.del').onclick=()=>{if(confirm('Bạn chắc chắn muốn xóa bài “'+n.title+'”?')){const next=read(K.news).filter(x=>x.id!==n.id);write(K.news,next);if($('newsId').value===n.id)$('newNews').click();renderNews();alert('Đã xóa bài viết.');}};tb.appendChild(tr)})}
function editNews(n){
$('newsId').value=n.id||'';$('nTitle').value=n.title||'';$('nKeyword').value=n.keyword||'';$('nSlug').value=n.slug||slug(n.title);$('nMeta').value=n.metaDescription||'';$('nCategory').value=n.category||'Tin tức mô tô';$('nCover').value=n.cover||'';$('nContent').value=n.content||'';$('nCoverFile').value='';$('nImageFile').value='';showCoverPreview(n.cover||'');$('imagePreview').innerHTML='';$('imagePreview').dataset.src='';updateSEO();document.querySelector('[data-page=news]').click();window.scrollTo({top:0,behavior:'smooth'});
}
$('newsForm').onsubmit=e=>{e.preventDefault();let arr=read(K.news),id=$('newsId').value||'N'+Date.now(),old=arr.find(x=>x.id===id),now=new Date().toISOString(),n={id,title:$('nTitle').value.trim(),keyword:$('nKeyword').value.trim(),slug:$('nSlug').value.trim()||slug($('nTitle').value),metaDescription:$('nMeta').value.trim(),category:$('nCategory').value.trim(),cover:$('nCover').value.trim(),content:$('nContent').value,status:old?.status||'published',updatedAt:now,publishedAt:old?.publishedAt||now};const i=arr.findIndex(x=>x.id===id);i>=0?arr[i]=n:arr.unshift(n);write(K.news,arr);renderNews();$('newsFormTitle').textContent='Chỉnh sửa bài SEO';alert(i>=0?'Đã cập nhật bài viết.':'Đã thêm bài viết mới.');};
function fileToDataURL(file){return new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(file)})}
function showCoverPreview(src){$('coverPreview').innerHTML=src?'<img src="'+esc(src)+'" alt="Ảnh đại diện">':''}
$('nCover').addEventListener('input',()=>showCoverPreview($('nCover').value.trim()));
$('nCoverFile').addEventListener('change',async e=>{const f=e.target.files?.[0];if(!f)return;if(f.size>2*1024*1024){alert('Ảnh đại diện tối đa 2MB trong bản demo.');e.target.value='';return}const src=await fileToDataURL(f);$('nCover').value=src;showCoverPreview(src)});
$('nImageFile').addEventListener('change',async e=>{const f=e.target.files?.[0];if(!f)return;if(f.size>2*1024*1024){alert('Ảnh tối đa 2MB trong bản demo.');e.target.value='';return}const src=await fileToDataURL(f);$('imagePreview').innerHTML='<img src="'+esc(src)+'" alt="Ảnh xem trước">';$('imagePreview').dataset.src=src});
$('insertImage').onclick=()=>{const src=$('imagePreview').dataset.src;if(!src){alert('Hãy chọn ảnh trước.');return}const alt=prompt('Mô tả ảnh (ALT SEO):','Ảnh minh họa')||'Ảnh minh họa';const html='<figure><img src="'+src+'" alt="'+esc(alt)+'" style="max-width:100%;height:auto"><figcaption>'+esc(alt)+'</figcaption></figure>';const ta=$('nContent');const start=ta.selectionStart,end=ta.selectionEnd;ta.value=ta.value.slice(0,start)+html+ta.value.slice(end);ta.focus();ta.selectionStart=ta.selectionEnd=start+html.length;updateSEO()};
$('newNews').onclick=()=>{$('newsForm').reset();$('newsId').value='';$('nCategory').value='Tin tức mô tô';$('coverPreview').innerHTML='';$('imagePreview').innerHTML='';$('imagePreview').dataset.src='';updateSEO();$('newsFormTitle').textContent='Viết bài SEO'};['nTitle','nKeyword','nMeta','nSlug','nContent'].forEach(id=>$(id).addEventListener('input',updateSEO));$('nTitle').addEventListener('blur',()=>{if(!$('nSlug').value)$('nSlug').value=slug($('nTitle').value);updateSEO()});
$('aiFill').onclick=()=>{$('aiTopic').value=$('nTitle').value;$('aiKw').value=$('nKeyword').value;document.querySelector('[data-page=ai]').click();};
function generateArticle(topic,kw,audience,tone){const s=slug(topic);const title=topic+' — Hướng dẫn chi tiết cho người yêu mô tô';const meta='Tìm hiểu '+kw+' với hướng dẫn thực tế, tiêu chí lựa chọn, kinh nghiệm sử dụng và những lưu ý quan trọng cho '+audience+'.';const content=`<p><strong>${topic}</strong> là chủ đề được nhiều người quan tâm khi tìm hiểu về ${kw}. Bài viết này tổng hợp các tiêu chí quan trọng, giúp bạn có góc nhìn rõ ràng trước khi lựa chọn.</p><h2>${kw}: Vì sao được quan tâm?</h2><p>Đối với người dùng mô tô, việc chọn đúng cấu hình, tư thế lái, chi phí vận hành và mục đích sử dụng quyết định rất lớn đến trải nghiệm. Hãy bắt đầu bằng nhu cầu thực tế thay vì chỉ nhìn vào công suất.</p><h2>Các tiêu chí cần kiểm tra</h2><p>Hãy đánh giá động cơ, trọng lượng, chiều cao yên, hệ thống phanh, trang bị an toàn, phụ tùng, khả năng bảo dưỡng và ngân sách tổng thể. Với xe nhập khẩu, nên kiểm tra thêm hồ sơ, nguồn gốc và tình trạng xe.</p><h2>Kinh nghiệm lựa chọn</h2><p>Nên so sánh ít nhất ba lựa chọn tương đương, lái thử nếu có thể và dự trù chi phí bảo dưỡng. Người mới nên ưu tiên khả năng kiểm soát và tư thế lái phù hợp.</p><h2>FAQ</h2><h3>${kw} có phù hợp người mới không?</h3><p>Điều này phụ thuộc vào dung tích, trọng lượng và kỹ năng. Hãy chọn cấu hình phù hợp khả năng kiểm soát của bạn.</p><h3>Cần kiểm tra gì trước khi mua?</h3><p>Kiểm tra nguồn gốc, giấy tờ, tình trạng máy, khung, phanh, lốp, hệ thống điện và lịch sử bảo dưỡng.</p><h2>Kết luận</h2><p>Chọn mô tô hiệu quả là bài toán cân bằng giữa nhu cầu, ngân sách và trải nghiệm. Nếu cần tư vấn, Tài Moto có thể hỗ trợ bạn tìm dòng xe phù hợp.</p>`;return {title,meta,slug:s,content,keyword:kw,category:'Tin tức mô tô',cover:'',status:'draft'}}
$('generateAI').onclick=()=>{const n=generateArticle($('aiTopic').value||'Kinh nghiệm chọn mô tô',$('aiKw').value||'mô tô',$('aiAudience').value,$('aiTone').value);$('aiResult').classList.remove('hidden');$('aiResult').innerHTML='<h3>'+esc(n.title)+'</h3><p>'+esc(n.meta)+'</p><div>'+n.content+'</div><button id="useAI" class="btn btn-gold">Đưa vào trình soạn thảo</button>';$('useAI').onclick=()=>{editNews({...n,id:''});}}; 
function renderAnalytics(){const a=read(K.analytics),views=a.filter(x=>x.type==='pageview');$('sViews').textContent=views.length;$('aViews').textContent=views.length;$('aMobile').textContent=(views.length?Math.round(views.filter(x=>x.device==='Mobile').length/views.length*100):0)+'%';$('aDesktop').textContent=(views.length?Math.round(views.filter(x=>x.device==='Desktop').length/views.length*100):0)+'%';$('aClicks').textContent=a.filter(x=>x.type==='news_click').length;$('aPurchases').textContent=a.filter(x=>x.type==='purchase').length;drawWeek('weekChart',a);drawWeek('analyticsWeek',a);drawBrowsers('browserChart',a);drawBrowsers('analyticsBrowser',a);const dev={Mobile:0,Desktop:0};views.forEach(x=>dev[x.device]=(dev[x.device]||0)+1);$('deviceStats').innerHTML=Object.entries(dev).map(([k,v])=>`<div class="browser-row"><span>${k}</span><div class="track"><i style="width:${views.length?v/views.length*100:0}%"></i></div><b>${v}</b></div>`).join('')}
function drawWeek(id,a){const el=$(id);if(!el)return;const days=[];for(let i=6;i>=0;i--){const d=new Date();d.setHours(0,0,0,0);d.setDate(d.getDate()-i);const key=d.toISOString().slice(0,10),v=a.filter(x=>x.type==='pageview'&&x.time.slice(0,10)===key).length;days.push({k:d.toLocaleDateString('vi-VN',{weekday:'short'}),v})}const max=Math.max(1,...days.map(x=>x.v));el.innerHTML=days.map(x=>`<div class="bar" style="height:${Math.max(5,x.v/max*100)}%"><span>${x.k}</span></div>`).join('')}
function drawBrowsers(id,a){const el=$(id);if(!el)return;const v=a.filter(x=>x.type==='pageview'),m={};v.forEach(x=>m[x.browser]=(m[x.browser]||0)+1);const max=Math.max(1,...Object.values(m));el.innerHTML=Object.entries(m).sort((a,b)=>b[1]-a[1]).map(([k,n])=>`<div class="browser-row"><span>${k}</span><div class="track"><i style="width:${n/max*100}%"></i></div><b>${n}</b></div>`).join('')||'<p class="muted">Chưa có dữ liệu.</p>'}
function renderData(){const p=read(K.products),o=read(K.orders);$('sProducts').textContent=p.length;$('sOrders').textContent=o.length;const cust={};o.forEach(x=>{const k=x.customer?.phone||x.customer?.email||x.customer?.name||'?';cust[k]=(cust[k]||{...x.customer,count:0});cust[k].count++});$('sCustomers').textContent=Object.keys(cust).length;$('productRows').innerHTML=p.map(x=>`<tr><td>${esc(x.name)}</td><td>${esc(x.type)}</td><td>${money(x.price)}</td></tr>`).join('');$('orderRows').innerHTML=o.slice().reverse().map(x=>`<tr><td>${x.id}</td><td>${esc(x.customer?.name)}</td><td>${money(x.total)}</td><td>${esc(x.status)}</td></tr>`).join('');$('customerRows').innerHTML=Object.values(cust).map(x=>`<tr><td>${esc(x.name)}</td><td>${esc(x.phone)}</td><td>${esc(x.email)}</td><td>${x.count}</td></tr>`).join('')}
function refresh(){ensureDemoNews();renderNews();renderAnalytics();renderData();updateSEO()}
$('loginForm').onsubmit=e=>{e.preventDefault();if($('password').value===ADMIN){sessionStorage.setItem('tmAdmin','1');$('loginGate').classList.add('hidden');$('app').classList.remove('hidden');refresh()}else $('loginError').textContent='Mật khẩu không đúng.'};
$('logout').onclick=()=>{sessionStorage.removeItem('tmAdmin');location.reload()};
if(sessionStorage.getItem('tmAdmin')==='1'){$('loginGate').classList.add('hidden');$('app').classList.remove('hidden');refresh()}
document.querySelectorAll('.side-btn').forEach(b=>b.onclick=()=>{document.querySelectorAll('.side-btn').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));$(b.dataset.page).classList.add('active');$('title').textContent=b.textContent.replace(/^[^ ]+ /,'');refresh()});
